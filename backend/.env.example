# ─── MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/krishi_agent
MONGODB_DB_NAME=krishi_agent

# ─── Environment ──────────────────────────────────────────────────
# development | production | test
ENVIRONMENT=development

# ─── Admin Authentication ────────────────────────────────────────
# Change these in production! Never use default credentials in production.
ADMIN_USERNAME=admin
# For development, you can use plaintext ADMIN_PASSWORD:
ADMIN_PASSWORD=changeme123
# For production, supply a bcrypt hash of your admin password (e.g. from bcrypt.hashpw)
# ADMIN_PASSWORD_HASH=$2b$12$...
# Strong random 256-bit secret key for JWT signatures (openssl rand -hex 32)
ADMIN_JWT_SECRET=dev-secret-key-change-in-production

# ─── Mock data toggle ─────────────────────────────────────────────
# true  = every agent (including disease detection & government schemes)
#         returns canned/random sample data and NEVER calls Groq — this is
#         why an uploaded photo can come back with a diagnosis unrelated to
#         what's actually in the image. Fine for local UI work without an
#         API key, but disease detection specifically only makes sense with
#         this set to false and a real GROQ_API_KEY below.
# false = agents call the real Groq API.
USE_MOCK_TOOLS=true

# ─── Groq API (required once USE_MOCK_TOOLS=false) ──────────────
# GROQ_API_KEY=your-key-here
# Text model for most agents. Current as of this writing; check
# https://console.groq.com/docs/deprecations before relying on this long-term.
# GROQ_MODEL=openai/gpt-oss-120b
# Vision-capable model used specifically by disease_detection_agent for
# analyzing uploaded crop/leaf photos. Must be a Groq model that accepts
# image input — plugging in a text-only model here will fail loudly, not
# silently misdiagnose.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
