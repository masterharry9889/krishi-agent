# ─── MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/krishi_agent
MONGODB_DB_NAME=krishi_agent

# ─── Admin Authentication ────────────────────────────────────────
# Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_JWT_SECRET=dev-secret-key-change-in-production

# ─── Mock Data Toggle ────────────────────────────────────────────
# When true, agents return pre-built responses without calling any LLM.
# This is fine for budget, soil, weather, and other text-based agents
# that produce plausible static data for local development.
#
# ⚠️  DISEASE DETECTION IS NOT MEANINGFUL IN MOCK MODE ⚠️
# Mock disease results are keyed by crop name from the farmer's profile,
# NOT by the uploaded image. If you see "[MOCK]" prefixed diagnoses,
# that's expected — the mock has no vision capability.
# Set USE_MOCK_TOOLS=false and provide GROQ_API_KEY for real diagnosis.
USE_MOCK_TOOLS=true

# ─── LLM Configuration ──────────────────────────────────────────
# REQUIRED for any non-mock agent calls (crop recommendation, etc.)
# Get your key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-key-here
#
# Text model (used by crop_recommendation, soil, weather, etc.)
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Vision model (REQUIRED for disease_detection_agent)
# Must be a vision-capable model on Groq (e.g. llama-4-scout, llama-3.2-11b-vision)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
